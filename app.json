{
  "expo": {
    "name": "Mana Community",
    "slug": "mana-community-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A024A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manacommunity.mobile",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:app.manacommunity.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2A024A"
      },
      "package": "com.manacommunity.mobile",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.manacommunity.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "mana-community"
            },
            {
              "scheme": "mana"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "disableAutoUpload": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mana Community needs access to your photos to update your profile.",
          "cameraPermission": "Mana Community needs access to your camera."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to sign in to Mana Community."
        }
      ],
      "expo-image",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mana Mobility needs your location to find the nearest pickup point."
        }
      ]
    ],
    "scheme": "mana-community",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e55b7092-4575-4d6e-bb11-dd2f29ff0d0e"
      }
    }
  }
}
