  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:local": "node scripts/start.mjs local",
    "start:local:tunnel": "node scripts/start.mjs local --tunnel",
    "start:cloud": "node scripts/start.mjs cloud",
